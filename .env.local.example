# === Supabase ===
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
# Supabase > Project Settings > API > service_role (GİZLİ! tarayıcıya asla gitmez)
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# === football-data.org ===
# https://www.football-data.org/client/register  (ücretsiz API anahtarı)
FOOTBALL_DATA_API_KEY=your-football-data-token

# === Cron güvenliği ===
# Rastgele uzun bir metin üret (ör: openssl rand -hex 32). Skor senkron endpointini korur.
CRON_SECRET=cok-gizli-rastgele-bir-deger

# === Site adresi ===
# Lokal için http://localhost:3000 , canlıda Vercel adresin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
